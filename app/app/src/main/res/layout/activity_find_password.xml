<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 뒤로가기 -->
        <Button
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="‹"
            android:textSize="22sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_back_btn"
            android:padding="0dp"
            android:layout_marginBottom="16dp"/>

        <!-- 로고 -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:src="@drawable/nudge_up_logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="비밀번호 찾기"
            android:textSize="26sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- 단계 표시기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Step 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_step1_circle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="✉"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:background="@drawable/bg_step_active"/>

            </LinearLayout>

            <!-- 연결선 1-2 -->
            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="0.4"
                android:background="@color/step_inactive"
                android:layout_marginBottom="0dp"/>

            <!-- Step 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_step2_circle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="☰"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:background="@drawable/bg_step_inactive"/>

            </LinearLayout>

            <!-- 연결선 2-3 -->
            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="0.4"
                android:background="@color/step_inactive"/>

            <!-- Step 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_step3_circle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="🔒"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:background="@drawable/bg_step_inactive"/>

            </LinearLayout>

        </LinearLayout>

        <!-- 단계 라벨 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <TextView
                android:id="@+id/tv_label_step1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:text="이메일 입력"
                android:textSize="10sp"
                android:textColor="@color/color_primary"
                android:gravity="center"/>

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0.4"/>

            <TextView
                android:id="@+id/tv_label_step2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:text="인증번호"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"/>

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0.4"/>

            <TextView
                android:id="@+id/tv_label_step3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:text="새 비밀번호"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"/>

        </LinearLayout>

        <!-- ===== STEP 1: 이메일 입력 ===== -->
        <LinearLayout
            android:id="@+id/layout_step1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="가입 시 등록한 이메일을 입력하세요"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이메일"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_step1_email"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="이메일을 입력하세요"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint_color"
                android:inputType="textEmailAddress"
                android:gravity="center_vertical"
                android:layout_marginBottom="32dp"/>

            <Button
                android:id="@+id/btn_step1_next"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="다음"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_primary"/>

        </LinearLayout>

        <!-- ===== STEP 2: 인증번호 확인 ===== -->
        <LinearLayout
            android:id="@+id/layout_step2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="이메일로 전송된 인증번호를 입력하세요"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이메일"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_step2_email_readonly"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_secondary"
                android:inputType="textEmailAddress"
                android:gravity="center_vertical"
                android:focusable="false"
                android:enabled="false"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="인증번호"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="32dp">

                <EditText
                    android:id="@+id/et_code"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="인증번호 6자리를 입력하세요"
                    android:background="@drawable/bg_input"
                    android:paddingStart="16dp"
                    android:paddingEnd="72dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint_color"
                    android:inputType="number"
                    android:gravity="center_vertical"/>

                <TextView
                    android:id="@+id/tv_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"
                    android:text="03:00"
                    android:textColor="@color/color_primary"
                    android:textSize="13sp"/>

            </RelativeLayout>

            <Button
                android:id="@+id/btn_step2_confirm"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="확인"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_primary"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_resend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="이메일 재전송"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:padding="8dp"/>

        </LinearLayout>

        <!-- ===== STEP 3: 새 비밀번호 설정 ===== -->
        <LinearLayout
            android:id="@+id/layout_step3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="새로운 비밀번호를 입력하세요"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="새 비밀번호"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/et_new_password"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="새 비밀번호를 입력하세요"
                    android:background="@drawable/bg_input"
                    android:paddingStart="16dp"
                    android:paddingEnd="52dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint_color"
                    android:inputType="textPassword"
                    android:gravity="center_vertical"/>

                <ImageButton
                    android:id="@+id/btn_toggle_new_pw"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_visibility"
                    android:background="@android:color/transparent"
                    android:scaleType="center"
                    android:contentDescription="새 비밀번호 표시"/>

            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="새 비밀번호 확인"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="32dp">

                <EditText
                    android:id="@+id/et_new_password_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="새 비밀번호를 다시 입력하세요"
                    android:background="@drawable/bg_input"
                    android:paddingStart="16dp"
                    android:paddingEnd="52dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint_color"
                    android:inputType="textPassword"
                    android:gravity="center_vertical"/>

                <ImageButton
                    android:id="@+id/btn_toggle_new_pw_confirm"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_visibility"
                    android:background="@android:color/transparent"
                    android:scaleType="center"
                    android:contentDescription="새 비밀번호 확인 표시"/>

            </RelativeLayout>

            <Button
                android:id="@+id/btn_step3_change"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="비밀번호 변경"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_primary"/>

        </LinearLayout>

        <!-- 하단 공통: 로그인으로 돌아가기 -->
        <TextView
            android:id="@+id/tv_back_to_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="로그인으로 돌아가기"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:padding="8dp"
            android:layout_marginTop="24dp"/>

    </LinearLayout>
</ScrollView>
