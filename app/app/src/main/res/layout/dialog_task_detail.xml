<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="24dp">

    <!-- 제목 -->
    <TextView
        android:id="@+id/tv_detail_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp"/>

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A45"
        android:layout_marginBottom="16dp"/>

    <!-- 상태 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="상태"
            android:textSize="12sp"
            android:textColor="#8888AA"/>

        <TextView
            android:id="@+id/tv_detail_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>

    </LinearLayout>

    <!-- 마감일 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="마감일"
            android:textSize="12sp"
            android:textColor="#8888AA"/>

        <TextView
            android:id="@+id/tv_detail_due_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_primary"/>

    </LinearLayout>

    <!-- 담당자 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="담당자"
            android:textSize="12sp"
            android:textColor="#8888AA"/>

        <TextView
            android:id="@+id/tv_detail_assignee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_primary"/>

    </LinearLayout>

    <!-- 상세내용 (설명이 있을 때만 표시) -->
    <LinearLayout
        android:id="@+id/layout_detail_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="상세내용"
            android:textSize="12sp"
            android:textColor="#8888AA"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_detail_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:lineSpacingMultiplier="1.5"
            android:background="#14142A"
            android:padding="12dp"/>

    </LinearLayout>

    <!-- 버튼 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <!-- 독촉 버튼 (조건부 표시) -->
        <TextView
            android:id="@+id/btn_detail_nudge"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="16dp"
            android:text="🔔 독촉 보내기"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FF7B3FE4"
            android:background="@android:color/transparent"
            android:visibility="gone"/>

        <!-- 닫기 버튼 -->
        <TextView
            android:id="@+id/btn_detail_close"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="4dp"
            android:text="닫기"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/color_lime"
            android:background="@android:color/transparent"/>

    </LinearLayout>

</LinearLayout>
