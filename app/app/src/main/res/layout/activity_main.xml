<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#13131F">

    <!-- ===== 왼쪽 사이드바 (65dp) ===== -->
    <LinearLayout
        android:layout_width="65dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/color_lime"
        android:gravity="center_horizontal">

        <!-- NudgeUp 로고 -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/nudge_up_logo_black"
            android:scaleType="fitCenter"
            android:contentDescription="NudgeUp 로고"/>

        <!-- 구분선 -->
        <View
            android:layout_width="32dp"
            android:layout_height="1dp"
            android:background="#1A1A2E"
            android:layout_marginBottom="8dp"/>

        <!-- 팀 탭 목록 (스크롤) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/sidebar_team_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </ScrollView>

        <!-- 팀 추가 버튼 (배경 없이 + 기호만) -->
        <TextView
            android:id="@+id/btn_add_team"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="+"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#13131F"
            android:background="@android:color/transparent"/>

    </LinearLayout>

    <!-- ===== 오른쪽 메인 콘텐츠 ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#13131F">

        <!-- 상단 바 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:background="@color/bg_dark">

            <TextView
                android:id="@+id/tv_team_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="개발팀"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <ImageButton
                android:id="@+id/btn_team_settings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_gear"
                android:background="@android:color/transparent"
                android:scaleType="center"
                android:visibility="gone"
                android:contentDescription="팀 설정"/>

            <TextView
                android:id="@+id/btn_my"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:text="MY"
                android:textSize="12sp"
                android:textColor="@color/color_lime"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_sidebar_tab_selected"/>

        </LinearLayout>

        <!-- 팀원 필터 (가로 스크롤 RecyclerView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_member_filter"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@color/bg_dark"
            android:clipToPadding="false"/>

        <!-- 상단 바와 콘텐츠 사이 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_border"/>

        <!-- 메인 스크롤 콘텐츠 -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#13131F"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="80dp">

                <!-- 팀원 전체 할일 카드 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="팀원 전체 할일"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"/>

                        <TextView
                            android:id="@+id/tv_team_task_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0건"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"/>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_border"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_team_tasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"/>

                </LinearLayout>

                <!-- 내 할일 카드 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="내 할일"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"/>

                        <TextView
                            android:id="@+id/tv_my_task_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0건"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"/>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_border"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_my_tasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"/>

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- 하단 바 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:background="@color/bg_dark">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_bell"
                android:scaleType="fitCenter"
                android:contentDescription="독촉 알림"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 독촉 알림 "
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="4dp"/>

            <TextView
                android:id="@+id/tv_nudge_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0회"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/color_lime"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/btn_new_task"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_plus"
                android:background="@drawable/bg_fab"
                android:scaleType="center"
                android:contentDescription="새 작업 추가"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
