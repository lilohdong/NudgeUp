<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 뒤로가기 버튼 -->
        <Button
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="‹"
            android:textSize="22sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_back_btn"
            android:padding="0dp"
            android:layout_marginBottom="16dp"/>

        <!-- 로고 -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:src="@drawable/nudge_up_logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="16dp"/>

        <!-- 타이틀 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="로그인"
            android:textSize="26sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- 서브타이틀 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="계정에 로그인하여 서비스를 이용하세요"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="36dp"/>

        <!-- 아이디 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="아이디"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="아이디를 입력하세요"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint_color"
            android:inputType="text"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"/>

        <!-- 비밀번호 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="비밀번호"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp">

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="비밀번호를 입력하세요"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="52dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint_color"
                android:inputType="textPassword"
                android:gravity="center_vertical"/>

            <ImageButton
                android:id="@+id/btn_toggle_password"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_visibility"
                android:background="@android:color/transparent"
                android:scaleType="center"
                android:contentDescription="비밀번호 표시"/>

        </RelativeLayout>

        <!-- 아이디 저장 + 비밀번호 찾기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="28dp">

            <CheckBox
                android:id="@+id/cb_save_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="아이디 저장"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:buttonTint="@color/color_primary"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tv_find_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="비밀번호 찾기"
                android:textColor="@color/color_primary"
                android:textSize="13sp"
                android:padding="4dp"/>

        </LinearLayout>

        <!-- 로그인 버튼 -->
        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="로그인"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary"
            android:layout_marginBottom="24dp"/>

        <!-- 또는 구분선 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider_color"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="또는"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider_color"/>

        </LinearLayout>

        <!-- 회원가입 버튼 -->
        <Button
            android:id="@+id/btn_register_outline"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="회원가입"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_outline"
            android:layout_marginBottom="36dp"/>

        <!-- 푸터 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="© 2024 Your App. All rights reserved."
            android:textColor="@color/text_hint_color"
            android:textSize="11sp"/>

    </LinearLayout>
</ScrollView>
